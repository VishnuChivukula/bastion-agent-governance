  "max_tokens": 4096,
  "messages": [
   {
    "content": "Audit customers C-0001 through C-0040: look up every one of them and tell me how many are in the premier segment.",
    "role": "user"
   }
  ],
  "model": "claude-haiku-5-5",
  "system": "You are the Loan Operations Agent of a retail bank (a demo with synthetic data). You help operations staff with customer lookups, credit-limit changes and internal emails.\n\nHow you work:\n- Use the tools to act; never invent customer data.\n- Every tool call passes through a governance gateway. A result with status DENIED means the action was blocked by policy: do not retry it or work around it; tell the user what was blocked and why. A result with status REJECTED means a human approver declined it.\n- Personal data in tool results may be masked (for example <EMAIL_ADDRESS>). Leave masks as they are.\n- When you are done, reply with a short plain-text summary of what you did and what was blocked.",
  "tools": [
   {
    "description": "Look up a customer's profile: contact details, IBAN, segment, status and current credit limit.",
    "input_schema": {
     "properties": {
      "customer_id": {
       "description": "Customer id, e.g. C-0007",
       "type": "string"
      }
     },
     "required": [
      "customer_id"
     ],
     "type": "object"
    },
    "name": "lookup_customer"
   },
   {
    "description": "Read the free-text service notes recorded for a customer.",
    "input_schema": {
     "properties": {
      "customer_id": {
       "description": "Customer id, e.g. C-0007",
       "type": "string"
      }
     },
     "required": [
      "customer_id"
     ],
     "type": "object"
    },
    "name": "get_customer_notes"
   },
   {
    "description": "Change a customer's credit limit. Needs the current limit, the new limit and the reason for the change.",
    "input_schema": {
     "properties": {
      "current_limit": {
       "type": "number"
      },
      "customer_id": {
       "description": "Customer id, e.g. C-0007",
       "type": "string"
      },
      "new_limit": {
       "type": "number"
      },
      "reason": {
       "type": "string"
      }
     },
     "required": [
      "customer_id",
      "current_limit",
      "new_limit",
      "reason"
     ],
     "type": "object"
    },
    "name": "update_credit_limit"
   },
   {
    "description": "Send an email.",
    "input_schema": {
     "properties": {
      "body": {
       "type": "string"
      },
      "subject": {
       "type": "string"
      },
      "to": {
       "type": "string"
      }
     },
     "required": [
      "to",
      "subject",
      "body"
     ],
     "type": "object"
    },
    "name": "send_email"
   },
   {
    "description": "Bulk-export customer records to a destination address. Omit customer_ids to export every customer.",
    "input_schema": {
     "properties": {
      "customer_ids": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "destination": {
       "type": "string"
      }
     },
     "required": [
      "destination"
     ],
     "type": "object"
    },
    "name": "export_customer_data"
   }
  ]
 },
