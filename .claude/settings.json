{
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash(uv:*)",
      "Bash(uvx:*)",
      "Bash(make:*)",
      "Bash(python3:*)",
      "Bash(git:*)",
      "Bash(gh auth status)",
      "Bash(gh repo create:*)",
      "Bash(gh repo view:*)",
      "Bash(gh repo edit:*)",
      "Bash(gh release create:*)",
      "Bash(gh release view:*)",
      "Bash(gh run list:*)",
      "Bash(gh run view:*)",
      "Bash(gh run watch:*)",
      "Bash(gh workflow run:*)",
      "Bash(docker build:*)",
      "Bash(docker compose:*)",
      "Bash(docker ps:*)",
      "Bash(ls:*)",
      "Bash(mkdir:*)",
      "Bash(pwd)",
      "Bash(which:*)",
      "Bash(curl -s http://localhost:*)",
      "WebFetch(domain:docs.claude.com)",
      "WebFetch(domain:docs.anthropic.com)",
      "WebFetch(domain:modelcontextprotocol.io)",
      "WebFetch(domain:langchain-ai.github.io)",
      "WebFetch(domain:microsoft.github.io)",
      "WebFetch(domain:pypi.org)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:docs.railway.com)",
      "WebFetch(domain:playwright.dev)"
    ],
    "deny": [
      "Read(./.env)",
      "Bash(cat .env*)",
      "Bash(less .env*)",
      "Bash(head .env*)",
      "Bash(tail .env*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(gh repo delete:*)",
      "Bash(sudo:*)",
      "Bash(rm -rf ~:*)",
      "Bash(rm -rf /:*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --quiet ruff format --quiet src tests demo evals scripts >/dev/null 2>&1 || true"
          }
        ]
      }
    ]
  }
}
